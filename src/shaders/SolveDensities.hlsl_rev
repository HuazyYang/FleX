#include "KernelParams.hlsli"

StructuredBuffer<uint> contacts : register(t0);
StructuredBuffer<int> contactCounts : register(t1);
StructuredBuffer<float4> sortedNewPositions : register(t2);
StructuredBuffer<uint> phases : register(t3);
StructuredBuffer<float> densities : register(t4);
StructuredBuffer<float4> sortedPositions : register(t6);
StructuredBuffer<float4> sortedNormals : register(t7);
RWByteAddressBuffer deltas : register(u0);

float3 ApplySolidFriction(float3 correction, float3 normal, float penetration, float massWeight, float3 relativeMotion) {
    if (gParams.kDynamicFriction <= 0.0 || dot(normal, normal) <= 0.0)
        return correction;

    float3 tangent = relativeMotion - dot(relativeMotion, normal) * normal;
    float tangentSq = dot(tangent, tangent);
    if (tangentSq <= 0.0)
        return correction;

    float3 weightedTangent = tangent * massWeight;
    float staticLimit = penetration * gParams.kStaticFriction;
    float dynamicScale = min(-penetration * gParams.kParticleFriction * rsqrt(tangentSq), 1.0);
    float3 staticCorrection = correction - weightedTangent;
    float3 dynamicCorrection = correction - weightedTangent * dynamicScale;
    return (tangentSq < staticLimit * staticLimit) ? staticCorrection : dynamicCorrection;
}

float3 SolidDensityCorrection(float3 position, float3 oldPosition, float4 particle,
                              float3 neighborPosition, float3 neighborOldPosition, float4 neighbor,
                              float4 selfNormal, float4 neighborNormal, float dist, float3 dir,
                              float3 correction) {
    if (dist > gParams.kSolidRestDistance)
        return correction;

    float4 surface = (neighborNormal.w < selfNormal.w) ? neighborNormal : selfNormal;
    float3 normal = dir;
    float penetration = dist - gParams.kSolidRestDistance;

    if (surface.w != 0.0) {
        normal = surface.xyz;
        if (surface.w >= -gParams.kSolidRestDistance) {
            float normalDot = dot(surface.xyz, dir);
            if (normalDot < 0.0)
                normal = dir - 2.0 * normalDot * surface.xyz;
        } else {
            penetration = surface.w;
        }
    }

    float massWeight = particle.w / (particle.w + neighbor.w);
    correction -= massWeight * penetration * normal;
    float3 relativeMotion = (position - neighborPosition) - (oldPosition - neighborOldPosition);
    return ApplySolidFriction(correction, normal, penetration, massWeight, relativeMotion);
}

[numthreads(256, 1, 1)]
void SolveDensities(uint idx : SV_DispatchThreadID) {
    if (idx >= uint(gParams.kNumParticles))
        return;

    float4 particle = sortedNewPositions[idx];
    if (particle.w == 0.0) {
        deltas.Store4(idx << 4, uint4(0, 0, 0, 0));
        return;
    }

    float3 oldPosition = sortedPositions[idx].xyz;
    float4 selfNormal = float4(-sortedNormals[idx].xyz, min(sortedNormals[idx].w, 0.0));
    float selfDensity = densities[idx];
    uint selfPhase = phases[idx];
    bool selfFluid = (selfPhase & eNvFlexPhaseFluid) != 0;
    int count = contactCounts[idx];
    uint contactIndex = idx;
    float4 delta = 0.0;

    [loop]
    for (int i = 0; i < count; ++i) {
        uint neighborIndex = contacts[contactIndex];
        contactIndex += uint(gParams.kNumParticlesAligned);

        float4 neighbor = sortedNewPositions[neighborIndex];
        float3 offset = particle.xyz - neighbor.xyz;
        float distSq = dot(offset, offset);
        if (distSq <= 0.0 || distSq > gParams.kRadiusSq)
            continue;

        float dist = sqrt(distSq);
        float3 dir = offset / dist;
        uint neighborPhase = phases[neighborIndex];
        bool neighborFluid = (neighborPhase & eNvFlexPhaseFluid) != 0;

        if (selfFluid && neighborFluid) {
            float lambda = selfDensity + densities[neighborIndex];
            float q = dist * gParams.kInvRadius;
            float grad = (1.0 - dist * gParams.kInvRadius) * -gParams.kSpiky2;
            float densityTerm = lambda * grad;

            if (selfPhase == neighborPhase) {
                float q2 = q * q;
                float cohesion = gParams.kCohesion * (gParams.kCohesion1 * q * q2 + gParams.kCohesion2 * q2 - 1.0);
                densityTerm += cohesion;
            }

            delta.xyz -= particle.w * densityTerm * dir;
        } else {
            delta.xyz = SolidDensityCorrection(particle.xyz,
                                               oldPosition,
                                               particle,
                                               neighbor.xyz,
                                               sortedPositions[neighborIndex].xyz,
                                               neighbor,
                                               selfNormal,
                                               sortedNormals[neighborIndex],
                                               dist,
                                               dir,
                                               delta.xyz);
        }

        delta.w += 1.0;
    }

    deltas.Store4(idx << 4, asuint(delta));
}
